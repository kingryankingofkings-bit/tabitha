{
  "name": "tabbridge",
  "version": "0.1.0",
  "private": true,
  "description": "Consent-gated, end-to-end encrypted, audited AI-agent messaging between browser tabs (MV3).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "demo:serve": "node demo/serve.mjs",
    "demo": "npm run build:e2e && node demo/run-demo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "5.0.2"
  }
}
